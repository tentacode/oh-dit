###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET={{ ohdit.secret }}
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://{{ postgresql.user }}:{{ postgresql.password }}@{{ postgresql.host }}:{{ postgresql.port }}/{{ postgresql.database_name }}?serverVersion={{ postgresql.version }}&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://{{ smtp.username }}:{{ smtp.password }}@{{ smtp.host }}:{{ smtp.port }}
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE={{ ohdit.secret }}
###< lexik/jwt-authentication-bundle ###

REDIS_URL=redis://localhost:6379

BREVO_API_KEY="{{ brevo_api_key }}"