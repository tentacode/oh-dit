---
// import Header from "../components/Layout/Header.astro";
import "../styles/global.css";
import { colorRoles, colors } from "../config/colors";
import Footer from "../components/Layout/Footer.astro";
import MatomoScript from "../components/Matomo/MatomoScript.astro";

const lang = "fr";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { pageTitle, metaDescription, metaRobots } = Astro.props;
const linkColor = colors.darkPurple;
const linkFocusColor = colors.pink;
const backgroundColor = colorRoles.light;
const textColor = colorRoles.dark;

if (pageTitle === undefined || metaDescription === undefined) {
	throw new Error("Layout.astro requires a pageTitle and a metaDescription prop.");
}

const metalLogo = Astro.site + "meta-banner.png";

const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL.toString()} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={metaDescription} />
		{metaRobots && <meta name="robots" content={metaRobots} />}
		<title>{pageTitle}</title>

		<link
			rel="preload"
			href="/fonts/LexendDeca-VariableFont_wght.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:image" content={metalLogo} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonicalURL.toString()} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Ohdit" />
		<meta property="og:image:alt" content="" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={metalLogo} />
		<meta name="twitter:image:alt" content="" />

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"name": "Ohdit",
				"url": "https://ohdit.com",
				"logo": "https://ohdit.com/meta-logo.png"
			}
		</script>
	</head>
	<body class="antialiased">
		<header>
			<a href={import.meta.env.PUBLIC_APP_BASE_URL}>Accès à la bêta</a>
		</header>
		<main>
			<slot />
		</main>
		<Footer />
		{isProd && <MatomoScript />}

		<style
			is:global
			define:vars={{
				backgroundColor: backgroundColor,
				textColor: textColor,
				linkColor: linkColor,
				linkFocusColor: linkFocusColor,
			}}
		>
			@font-face {
				font-family: "Lexend Deca";
				src: url("/fonts/LexendDeca-VariableFont_wght.woff2") format("woff2");
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}

			body {
				font-size: 1rem; /* minimum font size for WCAG AAA */
				color: var(--textColor);
				background-color: var(--backgroundColor);
			}

			a {
				text-decoration: underline;
				text-underline-offset: 2px;
				text-decoration-thickness: 1.5px;
				color: var(--textColor);
				text-decoration-color: var(--linkColor);
			}

			a:hover,
			a:focus {
				color: var(--textColor);
				text-decoration-color: var(--linkFocusColor);
				text-decoration-style: wavy;
			}

			svg {
				max-width: 100%;
				height: auto;
			}

			header {
				display: flex;
				justify-content: flex-end;
				padding: 20px;
				padding-bottom: 5px;
				background-color: var(--textColor);
				border: 0;
				overflow: visible;
				margin: -1px;
			}

			header a {
				font-size: 1.1em;
				font-weight: 600;
				color: white;
				border: 3px solid white;
				text-decoration: none;
				padding: 10px 15px;
				border-radius: 8px;
			}

			header a:hover,
			header a:focus {
				outline: 2px solid var(--linkFocusColor);
				outline-offset: 2px;
				border-color: var(--linkFocusColor);
				color: white;
			}
		</style>
	</body>
</html>
