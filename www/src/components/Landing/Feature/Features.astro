---
import Feature from "./Feature.astro";
import { colors } from "../../../config/colors";
import FeaturesIllustration from "../../Graphic/FeaturesIllustration.astro";
import SparklesIcon from "astro-heroicons/outline/Sparkles.astro";
import BookOpenIcon from "astro-heroicons/outline/BookOpen.astro";
import ChatBubbleBottomCenterTextIcon from "astro-heroicons/outline/ChatBubbleBottomCenterText.astro";
import ClipboardDocumentCheckIcon from "astro-heroicons/outline/ClipboardDocumentCheck.astro";
import RectangleStackIcon from "astro-heroicons/outline/RectangleStack.astro";
import SadRobot from "../../Icon/SadRobot.astro";
---

<div class="landingContainer featuresContainer">
	<div class="featuresLeft">
		<FeaturesIllustration />
	</div>

	<div class="featuresRight">
		<h2>Les fonctionnalités d'Ohdit</h2>
		<div class="featuresGrid">
			<Feature Icon={SparklesIcon}>
				<h3>Adieu les fichiers Excel</h3>
				<p>
					Choisissez comme vous préférez travailler : une vue grille familière et optimisée ou une
					vue détaillée par critère ou par écran.
				</p>
			</Feature>
			<Feature Icon={RectangleStackIcon}>
				<h3>Tous vos projets sont ici</h3>
				<p>
					Centralisez vos projets et vos clients pour un meilleur suivi. Configurez chaque projet
					pour détailler les écrans et composants des applications à auditer.
				</p>
			</Feature>
			<Feature Icon={ChatBubbleBottomCenterTextIcon}>
				<h3>Collaborons efficacement</h3>
				<p>
					Échangez simplement dans votre équipe et fournissez des recommandations pertinentes à vos
					clients.
				</p>
			</Feature>
			<Feature Icon={BookOpenIcon}>
				<h3>Une vraie documentation</h3>
				<p>
					Ohdit éclaircit la réglementation (RGAA, RAAM) pour que celles et ceux qui auditent, qui
					développent et qui pilotent parlent le même langage.
				</p>
			</Feature>
			<Feature Icon={ClipboardDocumentCheckIcon}>
				<h3>Des rapports clairs</h3>
				<p>
					Votre clientèle appréciera des rapports clairs lui permettant de visualiser facilement le
					résultat de l'audit et les actions à entreprendre.
				</p>
			</Feature>
			<Feature Icon={SadRobot} iconColor={colors.pink}>
				<h3>Garanti sans robot !</h3>
				<p>
					Ohdit n'est pas une solution magique qui réalise les audits à votre place (désolé !). Vous
					gardez le contrôle et réalisez votre audit dans des conditions optimales.
				</p>
			</Feature>
		</div>
	</div>
</div>

<style>
	.featuresContainer {
		display: flex;
		gap: 60px;
		margin-bottom: 100px;
	}

	.featuresLeft {
		flex: 1;
		margin-top: 100px;
	}

	.featuresRight {
		flex: 2;
	}

	.featuresGrid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-column-gap: 40px;
		grid-row-gap: 65px;
	}

	h2 {
		font-size: 3.5rem;
		font-weight: 700;
		margin-bottom: 2rem;
	}

	h3 {
		font-size: 1.5rem;
		font-weight: 600;
	}

	p {
		margin-top: 0.5rem;
		font-size: 1.2rem;
		line-height: 1.5;
	}

	@media (max-width: 1350px) {
		h2 {
			font-size: 3rem;
		}
		.featuresContainer {
			padding: 0 40px;
			align-items: center;
		}

		.featuresLeft {
			display: none;
		}

		.featuresRight {
			flex: 1;
			max-width: 800px;
			margin: auto;
		}

		.featuresGrid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			grid-column-gap: 40px;
			grid-row-gap: 65px;
		}
	}

	@media (max-width: 768px) {
		h2 {
			max-width: 100%;
			font-size: 2.5rem;
		}

		.featuresRight {
			max-width: 100%;
		}

		.featuresGrid {
			display: grid;
			grid-template-columns: 1fr;
			grid-column-gap: 40px;
			grid-row-gap: 65px;
		}
	}

	@media (max-width: 360px) {
		h2 {
			font-size: 2rem;
			word-wrap: break-word;
		}
	}
</style>
