---
import NewsletterIllustration from "../../Graphic/NewsletterIllustration.astro";
import ThankYouIllustration from "../../Graphic/ThankYouIllustration.astro";
import NewsletterForm from "./NewsletterForm.astro";
import NewsletterConfirmation from "./NewsletterConfirmation.astro";
---

<div class="landingContainer newsletterContainer">
	<div class="illustration">
		<div id="newsletterFormIllustration"><NewsletterIllustration /></div>
		<div id="newsletterConfirmationIllustration" style="display:none;">
			<ThankYouIllustration />
		</div>
	</div>
	<div class="newsletterFormContainer">
		<h2>Restez informé·e·s !</h2>
		<p>
			Si notre projet vous intéresse, n'hésitez pas à vous inscrire à notre newsletter pour être
			tenu au courant des avancées et être dans les premiers à tester Ohdit.
		</p>
		<div id="newsletterForm"><NewsletterForm /></div>
		<div id="newsletterConfirmation" style="display:none;"><NewsletterConfirmation /></div>
	</div>
</div>

<style>
	h2 {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 20px;
	}

	p {
		font-size: 1.3em;
	}

	.newsletterContainer {
		display: flex;
		flex-direction: row;
		gap: 50px;
		margin-bottom: 120px;
		padding: 40px 40px;
	}

	.newsletterFormContainer {
		flex: 2;
	}

	.illustration {
		flex: 1;
	}

	@media (max-width: 1350px) {
		.illustration {
			max-width: 300px !important;
		}
		.newsletterContainer {
			align-items: flex-start;
			flex-direction: column;
			gap: 20px;
		}
	}

	@media (max-width: 800px) {
		.newsletterContainer {
			max-width: 100%;
		}
		h2 {
			max-width: 100%;
			word-wrap: break-word;
			font-size: 2.5rem;
		}
	}

	@media (max-width: 420px) {
		h2 {
			font-size: 2rem;
		}
	}
</style>

<script>
	const { successfullySubscribed } = await import("./store.js");
	successfullySubscribed.subscribe((sub) => {
		const newsletterForm = document.getElementById("newsletterForm");
		const newsletterFormIllustration = document.getElementById("newsletterFormIllustration");
		const newsletterConfirmation = document.getElementById("newsletterConfirmation");
		const newsletterConfirmationIllustration = document.getElementById(
			"newsletterConfirmationIllustration",
		);

		if (sub) {
			newsletterForm?.style.setProperty("display", "none");
			newsletterFormIllustration?.style.setProperty("display", "none");
			newsletterConfirmation?.style.setProperty("display", "block");
			newsletterConfirmationIllustration?.style.setProperty("display", "block");

			const offsetScroll = newsletterConfirmation.offsetTop - 20;
			window.scrollTo({ top: offsetScroll, behavior: "smooth" });
		} else {
			newsletterForm?.style.setProperty("display", "block");
			newsletterFormIllustration?.style.setProperty("display", "block");
			newsletterConfirmation?.style.setProperty("display", "none");
			newsletterConfirmationIllustration?.style.setProperty("display", "none");
		}
	});
</script>
