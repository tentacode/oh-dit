---
import { colorRoles } from "../../config/colors";

const color = colorRoles.light;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	fill="none"
	viewBox="0 0 24 24"
	stroke-width="1"
	stroke={color}
	aria-hidden="true"
	focusable="false"
	width="400"
>
	<!-- Robot head (square instead of circle) -->
	<rect x="5" y="5" width="14" height="14" rx="1" stroke-linecap="round" stroke-linejoin="round"
	></rect>

	<!-- Robot eyes (square/rectangular) -->
	<rect x="8.5" y="9.5" width="1.5" height="1.5" fill={color}></rect>
	<rect x="14" y="9.5" width="1.5" height="1.5" fill={color}></rect>

	<!-- Sad mouth (downturned arc, same as original) -->
	<path
		stroke-linecap="round"
		stroke-linejoin="round"
		d="M15.182 16.318A4.486 4.486 0 0 0 12.016 15a4.486 4.486 0 0 0-3.198 1.318"></path>
</svg>
