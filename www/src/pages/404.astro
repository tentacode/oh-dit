---
import Error404 from "../components/Graphic/Error404.astro";
import Layout from "../layouts/Layout.astro";

const pageTitle = "Page non trouvée (404) - Ohdit";
const metaDescription =
	"Ohdit facilite les audits d'accessibilité RGAA et RAAM. Remplacez vos Excel par des vues optimisées, centralisez vos projets et générez des rapports clairs pour vos clients.";
const metaRobots = "noindex, nofollow";
---

<Layout metaDescription={metaDescription} pageTitle={pageTitle} metaRobots={metaRobots}>
	<div class="m-auto text-center">
		<div class="illustration flex">
			<Error404 />
		</div>	

		<div class="text">
			<h1 class="text-4xl font-bold text-gray-800">Oh! Cette page n'a pas été trouvée.</h1>

			<!-- Back home link -->
			<a href="/" class="text-3xl"> Revenir à la page d'accueil </a>
		</div>
	</div>
</Layout>

<style>
	html,
	body {
		height: 100%;
	}

	main {
		display: flex;
		height: 100%;
	}

	.text-center {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		justify-content: center;
		gap: 20px;
		height: 100%;
	}

	.illustration {
		flex: 2;
	}

	.text {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		gap: 20px;
		padding: 20px;
	}
</style>
