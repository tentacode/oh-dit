---
import Features from "../components/Landing/Feature/Features.astro";
import Hero from "../components/Landing/Hero/Hero.astro";
import Newsletter from "../components/Landing/Newsletter/Newsletter.astro";
import Layout from "../layouts/Layout.astro";

const pageTitle = "Plateforme collaborative pour faciliter vos audits d'accessibilité";
const metaDescription =
	"Ohdit facilite les audits d'accessibilité RGAA et RAAM. Remplacez vos Excel par des vues optimisées, centralisez vos projets et générez des rapports clairs pour vos clients.";
---

<Layout metaDescription={metaDescription} pageTitle={pageTitle}>
	<Hero />
	<Features />
	<Newsletter client:idle />
</Layout>
