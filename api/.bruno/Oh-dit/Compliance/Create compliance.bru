meta {
  name: Create compliance
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/compliances
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{AUTH_TOKEN}}
}

body:json {
  {
    "status": "compliant",
    "ruleUuid": "12341234-2222-4000-8001-000000000006",
    "projectUuid": "22222222-0000-4000-8000-000000000001",
    "screenUuid": "33333333-0000-4000-8000-000000000001"
  }
}

settings {
  encodeUrl: false
  timeout: 0
}
