meta {
  name: Create project
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/projects
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{AUTH_TOKEN}}
}

body:json {
  {
    "teamUuid": "11111111-0000-4000-8000-000000000001",
    "name": "C'est notre projeeeeeeet",
    "url": "https://e-macron.fr",
    "screens": [{
      "rank": 1,
      "name": "Accueil",
      "url": "/"
    }, 
    {
      "rank": 2,
      "name": "Contact",
      "url": "/contact"
    }]
  }
}

settings {
  encodeUrl: false
  timeout: 0
}
