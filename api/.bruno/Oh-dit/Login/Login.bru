meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/login_check
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{USER_EMAIL}}",
    "password": "{{USER_PASSWORD}}"
  }
}

script:post-response {
  const responseJson = res.getBody();
  bru.setEnvVar("AUTH_TOKEN", responseJson.token);
}

settings {
  encodeUrl: false
  timeout: 0
}
