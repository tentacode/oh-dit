---
import "@fontsource/lexend-deca";
import "@fontsource/lexend-deca/600.css"; // 600 semi-bold
import "@fontsource/lexend-deca/700.css"; // 700 bold
import "../styles/global.css";
// import Header from "../components/Layout/Header.astro";
import "../styles/global.css";
import { colorRoles, colors } from "../config/colors";
import Footer from "../components/Layout/Footer.astro";

const lang = "fr";
const { pageTitle } = Astro.props;
const linkColor = colors.darkPurple;
const linkFocusColor = colors.pink;
const backgroundColor = colorRoles.light;
const textColor = colorRoles.dark;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Ohdit - {pageTitle}</title>

		<!-- Matomo -->
		<script is:inline>
			var _paq = window._paq = window._paq || [];
			_paq.push(['disableCookies']);
			_paq.push(['trackPageView']);
			_paq.push(['enableLinkTracking']);
			(function() {
			var u="//analytics.ohdit.com/";
			_paq.push(['setTrackerUrl', u+'matomo.php']);
			_paq.push(['setSiteId', '1']);
			var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
			g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
			})();
		</script>
		<!-- End Matomo Code -->
	</head>
	<body class="antialiased">
		<!-- <Header /> -->
		<slot />
		<Footer />
	</body>
</html>

<style
	is:global
	define:vars={{
		backgroundColor: backgroundColor,
		textColor: textColor,
		linkColor: linkColor,
		linkFocusColor: linkFocusColor,
	}}
>
	body {
		font-size: 1rem; /* minimum font size for WCAG AAA */
		color: var(--textColor);
		background-color: var(--backgroundColor);
	}

	a {
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-thickness: 1.5px;
		color: var(--textColor);
		text-decoration-color: var(--linkColor);
	}

	a:hover, a:focus {
		color: var(--textColor);
		text-decoration-color: var(--linkFocusColor);
		text-decoration-style: wavy;
	}

	svg {
		max-width: 100%;
		height: auto;
	}
</style>
