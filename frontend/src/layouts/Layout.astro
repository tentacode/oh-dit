---
import "@fontsource/lexend-deca";
import "@fontsource/lexend-deca/600.css"; // 600 semi-bold
import "@fontsource/lexend-deca/700.css"; // 700 bold
import "../styles/global.css";
// import Header from "../components/Layout/Header.astro";
import "../styles/global.css";
import { colorRoles } from "../config/colors";

const lang = "fr";
const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Ohdit - {pageTitle}</title>
	</head>
	<body class="antialiased">
		<!-- <Header /> -->
		<slot />
	</body>
</html>

<style define:vars={{ backgroundColor: colorRoles.light, textColor: colorRoles.dark }}>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	html {
		color: var(--textColor);
		background-color: var(--backgroundColor);
	}
</style>
