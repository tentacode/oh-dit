---
import { colorRoles } from "../../config/colors"
---
<style define:vars={{ strokeColor: colorRoles.accent }}>
    span {
      position: relative;
      color: var(--strokeColor);
    }
    svg {
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 100%;
      height: 10px;
    }
</style>
<span><slot /><svg viewBox="0 0 100 10" preserveAspectRatio="none">
    <path
      d="M0,5 Q25,2 50,5 T100,5"
      stroke={colorRoles.light}
      stroke-width="6"
      fill="none"
      stroke-linecap="round"></path>
  </svg></span>
