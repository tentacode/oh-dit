---
import { colorRoles, colors } from "../../../config/colors";

const backgroundColor = colorRoles.dark;
const accentColor = colorRoles.accent;
const greenColor = colors.green;
const clipPath = "polygon(0 0, 100% 0,100% calc(100% - 4.5vw), 0 100%);";
---

<div class="clipPathFirst">
	<div class="clipPathSecond">
		<div class="clipPathThird">
			<slot />
		</div>
	</div>
</div>

<style
	define:vars={{
		accentColor: accentColor,
		greenColor: greenColor,
		backgroundColor: backgroundColor,
		clipPath: clipPath,
	}}
>
	.clipPathFirst {
		padding-bottom: 20px;
		margin-bottom: 20px;
		background-color: var(--accentColor);
		clip-path: var(--clipPath);
		overflow: hidden;
		width: 100%;
	}

	.clipPathSecond {
		clip-path: var(--clipPath);
		padding-bottom: 10px;
		background-color: var(--greenColor);
		overflow: hidden;
		width: 100%;
	}

	.clipPathThird {
		clip-path: var(--clipPath);
		background-color: var(--backgroundColor);
		overflow: hidden;
		width: 100%;
		padding-bottom: 30px;
	}
</style>
