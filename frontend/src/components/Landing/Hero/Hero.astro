---
import CheckListIllustration from "../../Graphic/CheckListIllustration.astro";
import Penstroke from "../../UI/Penstroke.astro";
// import Button from "../../UI/Button.astro";
import HeroClipPath from "./HeroClipPath.astro";
// import { colorRoles } from "../../../config/colors";
import OhditLogo from "../../Graphic/OhditLogo.astro";
---

<HeroClipPath>
	<div class="heroContainer px-6">
		<OhditLogo width="450px" />
		<div class="mx-auto flex max-w-6xl text-center">
			<div class="flex flex-6 flex-col justify-center">
				<h1 class="text-6xl font-semibold tracking-tight text-balance">
					L&apos;audit d&apos;accessibilité numérique,
					<Penstroke>facilement</Penstroke>.
				</h1>
				<p class="mx-auto mt-6 max-w-xl text-2xl text-pretty">
					Ohdit réunit tout les acteurs de vos audits d'accessibilité numérique dans une interface
					intuitive.
				</p>
				<!-- <div class="mt-10 flex items-center justify-center gap-x-6">
					<Button href="#" borderColor={colorRoles.accent}>Je teste Ohdit !</Button>
				</div> -->
			</div>

			<CheckListIllustration />
		</div>
	</div>
</HeroClipPath>

<style>
	.heroContainer {
		padding-top: 80px;
		padding-bottom: 130px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		justify-content: center;
		align-items: center;
		text-align: center;
		gap: 40px;
	}
</style>
