---
import EnvelopeIcon from "astro-heroicons/outline/Envelope.astro";
import { colorRoles, colors } from "../../../config/colors";

const accentColor = colorRoles.accent;
const focusColor = colorRoles.accent;
const mainColor = colorRoles.dark;
const errorColor = colors.red;
---

<form id="newsletterForm">
	<div class="inputRow">
		<label for="email-address">Votre Email :</label>
		<input
			type="email"
			autocomplete="email"
			id="email-address"
			name="email"
			required
		/>
	</div>
	<div class="checkboxRow">
		<input type="checkbox" id="consentBeta" name="consentBeta" />
		<label for="consentBeta">Je suis intéressé(e) pour tester Ohdit en avant première.</label>
	</div>
	<div class="checkboxRow">
		<input type="checkbox" id="consentNewsletter" name="consentNewsletter" />
		<label for="consentNewsletter">J'accepte de recevoir la newsletter d'Ohdit.</label>
	</div>
	<div class="checkboxRow">
		<input type="checkbox" id="consentBlog" name="consentBlog" />
		<label for="consentBlog"
			>J'accepte d'être notifié des articles du blog d'Ohdit sur l'accessibilité numérique (il
			arrive très bientôt !).</label
		>
	</div>
	<p class="errorMessage" id="checkbox-error" role="alert" aria-live="polite"></p>
	<button id="newsletterSubmitButton" type="submit">
		<EnvelopeIcon width="27" />
		S'inscrire
	</button>
</form>

<p class="aboutSpam">
	<strong>Pas de spam ici : </strong>
	nous ne partagerons jamais votre adresse email avec des tiers. Nous utilisons <a
		href="https://www.brevo.com">Brevo</a
	> pour gérer notre newsletter, vous pouvez consulter leur <a
		href="https://www.brevo.com/fr/legal/privacypolicy/"
		rel="noopener">politique de confidentialité</a
	>.
</p>

<script>
	const { successfullySubscribed } = await import("./store.js");

	const form = document.getElementById("newsletterForm");
	const checkboxError = document.getElementById("checkbox-error");
	const submitButton = document.getElementById("newsletterSubmitButton");

	const consentBeta = document.getElementById("consentBeta");
	const consentNewsletter = document.getElementById("consentNewsletter");
	const consentBlog = document.getElementById("consentBlog");

	// Clear errors when user checks any checkbox
	[consentBeta, consentNewsletter, consentBlog].forEach((checkbox) => {
		checkbox.addEventListener("change", () => {
			checkboxError.textContent = "";
		});
	});

	// Validate at least one checkbox is checked
	function isAtLeastOneCheckboxChecked() {
		return consentBeta.checked || consentNewsletter.checked || consentBlog.checked;
	}

	form.addEventListener("submit", async (e) => {
		e.preventDefault();

		if (!isAtLeastOneCheckboxChecked()) {
			checkboxError.textContent =
				"Choisissez au moins une des options de la newsletter pour que l'on puisse vous contacter.";
			return false;
		} else {
			checkboxError.textContent = "";
		}

		submitButton.disabled = true;

		// Prepare form data
		const formData = {
			email: document.getElementById("email-address").value,
			consentBeta: consentBeta.checked,
			consentNewsletter: consentNewsletter.checked,
			consentBlog: consentBlog.checked,
		};

		// Call backend API
		try {
			await fetch(`${import.meta.env.PUBLIC_BACKEND_API_BASE_URL}/api/newsletters`, {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify(formData),
			});
			
			window._paq.push(['trackEvent', 'Newsletter', 'Signup', 'Landing Page']);

		} catch (error) {
			// Ignore errors as requested
			console.error("Error submitting newsletter form:", error);
		}

		// Always treat as success
		successfullySubscribed.set(true);
	});
</script>

<style
	define:vars={{
		accentColor: accentColor,
		focusColor: focusColor,
		mainColor: mainColor,
		errorColor: errorColor,
	}}
>
	form {
		margin-top: 20px;
	}

	.inputRow {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-bottom: 20px;
	}

	label {
		font-size: 1.2em;
		font-weight: 600;
	}

	input[type="email"] {
		border: 5px solid var(--mainColor);
		font-size: 1.2em;
		width: 70%;
		border-radius: 15px;
		height: 60px;
		padding: 0 15px;
		background-color: white;
		transition: border-color 0.2s ease;
	}

	input[type="email"]:focus {
		border: 5px solid var(--focusColor);
		outline: none;
	}

	input[type="email"].error {
		border: 5px solid var(--errorColor);
	}

	.checkboxRow {
		display: flex;
		align-items: flex-start;
		gap: 15px;
		margin-bottom: 15px;
		font-size: 1.1em;
	}

	.checkboxRow input[type="checkbox"] {
		margin-top: 0.5cap;
		width: 20px;
		height: 20px;
		border: 3px solid var(--mainColor);
		accent-color: var(--accentColor);
	}

	.checkboxRow label {
		font-weight: 400;
		flex: 1;
	}

	button {
		margin-top: 20px;
		border: 5px solid var(--mainColor);
		font-size: 1.2em;
		font-weight: 600;
		width: 70%;
		border-radius: 15px;
		height: 60px;
		padding: 0 15px;
		background-color: var(--accentColor);
		color: var(--mainColor);
		display: flex;
		gap: 10px;
		justify-content: center;
		align-items: center;
		transition: all 0.2s ease;
	}

	button:hover:not(:disabled) {
		border: 5px solid var(--accentColor);
		cursor: pointer;
	}

	button:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.aboutSpam {
		margin-top: 20px;
		font-size: 1em;
	}

	.errorMessage {
		color: var(--errorColor);
		font-weight: 600;
		margin: 5px 0 0 0;
		padding: 15px;
		border-radius: 15px;
		border: 5px solid var(--errorColor);
		transition: opacity 0.3s ease;
	}

	.errorMessage:empty {
		display: none;
	}
</style>
