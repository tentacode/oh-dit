---
import CheckCircleIcon from "astro-heroicons/outline/CheckCircle.astro";
import { colors } from "../../../config/colors";

const successColor = colors.green;
---

<div class="thankYou">
	<div class="icon">
		<CheckCircleIcon />
	</div>
	<p>
		<strong>Merci !</strong> Vous êtes inscrit(e) à la newsletter. Nous vous tiendrons informé(e) des
		avancées du projet.
	</p>
</div>

<style define:vars={{ successColor: successColor }}>
	.thankYou {
		display: flex;
		margin-top: 20px;
		border: solid 5px var(--successColor);
		border-radius: 20px;
		padding: 15px;
		font-size: 1.1em;
		gap: 20px;
	}

	.thankYou .icon {
		width: 50px;
		height: 50px;
		color: var(--successColor);
	}

	.thankYou p {
		flex: 1;
	}
</style>
