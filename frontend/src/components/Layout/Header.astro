---
import Bars3Icon from "astro-heroicons/outline/Bars3.astro";
import XMarkIcon from "astro-heroicons/outline/XMark.astro";
import OhditLogo from "../Graphic/OhditLogo.astro";

const navigation = [
	{ name: "Fonctionnalités", href: "/features" },
	{ name: "Je teste Ohdit !", href: "/test-ohdit" },
	{ name: "Notre blog accessibilité", href: "/blog" },
];

// Import color config - adjust path as needed
import { colorRoles } from "../../config/colors";
---

<header style={`background-color: ${colorRoles.dark}; color: ${colorRoles.light};`}>
	<nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-8">
		<div class="flex items-center gap-x-12">
			<a href="/" class="-m-1.5 p-1.5">
				<span class="sr-only">Ohdit</span>
				<OhditLogo />
			</a>
			<div class="hidden lg:flex lg:gap-x-12">
				{
					navigation.map((item) => (
						<a href={item.href} class="text-xl font-semibold text-white hover:text-gray-300">
							{item.name}
						</a>
					))
				}
			</div>
		</div>
		<div class="flex lg:hidden">
			<button
				type="button"
				id="mobile-menu-button"
				class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-300 hover:text-white"
			>
				<span class="sr-only">Open main menu</span>
				<Bars3Icon class="size-6" />
			</button>
		</div>
		<div class="hidden lg:flex">
			<a href="/login" class="text-xl font-semibold text-white hover:text-gray-300">
				Me connecter <span aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</nav>

	<!-- Mobile menu -->
	<div id="mobile-menu" class="hidden lg:hidden">
		<div class="fixed inset-0 z-50"></div>
		<div
			class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-gray-900 p-6 sm:max-w-sm sm:ring-1 sm:ring-gray-700"
		>
			<div class="flex items-center justify-between">
				<a href="/" class="-m-1.5 p-1.5">
					<span class="sr-only">Ohdit</span>
					<img
						alt=""
						src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&shade=600"
						width="32"
						height="32"
						class="h-8 w-auto"
					/>
				</a>
				<button
					type="button"
					id="mobile-menu-close"
					class="-m-2.5 rounded-md p-2.5 text-gray-300 hover:text-white"
				>
					<span class="sr-only">Fermer le menu</span>
					<XMarkIcon class="size-6" />
				</button>
			</div>
			<div class="mt-6 flow-root">
				<div class="-my-6 divide-y divide-gray-700">
					<div class="space-y-2 py-6">
						{
							navigation.map((item) => (
								<a
									href={item.href}
									class="-mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-white hover:bg-gray-800"
								>
									{item.name}
								</a>
							))
						}
					</div>
					<div class="py-6">
						<a
							href="/login"
							class="-mx-3 block rounded-lg px-3 py-2.5 text-base/7 font-semibold text-white hover:bg-gray-800"
						>
							Log in
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	const mobileMenuButton = document.getElementById("mobile-menu-button");
	const mobileMenuClose = document.getElementById("mobile-menu-close");
	const mobileMenu = document.getElementById("mobile-menu");

	mobileMenuButton?.addEventListener("click", () => {
		mobileMenu?.classList.remove("hidden");
	});

	mobileMenuClose?.addEventListener("click", () => {
		mobileMenu?.classList.add("hidden");
	});
</script>
